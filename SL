local lastFullScan = 0
local function getAliveBoss()
    local function checkIsBoss(model)
        local hum = model:FindFirstChildOfClass("Humanoid")
        local root = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart or model:FindFirstChild("BossDamageHitbox")
        if root then
            local hNode = model:FindFirstChild("stats") and model.stats:FindFirstChild("Health")
            local ch = (hNode and hNode.Value) or workspace:GetAttribute("BossHealth") or (hum and hum.Health)
            if ch and ch > 0 then return true, root end
        end
        return false, nil
    end

    if currentTargetBoss and currentBossRoot and currentTargetBoss:IsDescendantOf(workspace) then
        local isValid, root = checkIsBoss(currentTargetBoss)
        if isValid then return currentTargetBoss, root end
    end
    
    for _, candidate in ipairs(services.CollectionService:GetTagged("BossEventBoss")) do
        if candidate:IsA("Model") and candidate:IsDescendantOf(workspace) then
            local isValid, root = checkIsBoss(candidate)
            if isValid then return candidate, root end
        end
    end
    
    if tick() - lastFullScan >= 1 then
        lastFullScan = tick()
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("Model") and (obj.Name == "Boss" or string.match(obj.Name, "^Boss%d+$")) then
                local isValid, root = checkIsBoss(obj)
                if isValid then return obj, root end
            end
        end
    end
    return nil, nil
end

local function doChestCollect()
    task.spawn(function()
        local timeout = 8; local elapsed = 0; local chestFoundAtLeastOnce = false
        while elapsed < timeout do
            local chest = nil
            for _, c in ipairs(services.CollectionService:GetTagged("BossEventChest")) do
                if c:IsDescendantOf(workspace) then chest = c; break end
            end
            if not chest then chest = workspace:FindFirstChild("BossChest", true) end
            
            local hasChest = false
            if chest then
                local prompt = chest:FindFirstChild("bossChestPrompt", true)
                local part = prompt and prompt.Parent or (chest:IsA("Model") and chest.PrimaryPart) or chest
                if part and part:IsA("BasePart") then
                    local hrp = utils.playerData.Character and utils.playerData.Character:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        hrp.CFrame = CFrame.new(part.Position + Vector3.new(0, 7, 0))
                        hrp.Velocity = Vector3.new(0,0,0); hrp.RotVelocity = Vector3.new(0,0,0)
                        if prompt and fireproximityprompt then pcall(function() fireproximityprompt(prompt) end)
                        else pcall(function() services.VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game) end) end
                        hasChest = true
                    end
                end
            end
            if hasChest then chestFoundAtLeastOnce = true
            elseif chestFoundAtLeastOnce then pcall(function() services.VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game) end); break end
            task.wait(0.1); elapsed = elapsed + 0.1
        end
        pcall(function() services.VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game) end)
    end)
end

