function utils.library:AddWindow(title, config)
    local windowObj = {}
    windowObj.RayfieldWindow = Rayfield:CreateWindow({
        Name = title,
        LoadingTitle = "Silence Script",
        LoadingSubtitle = "by Henrik @xyzhenrik",
        ConfigurationSaving = { Enabled = false },
        KeySystem = false
    })

    function windowObj:SetTitle(newTitle) end

    function windowObj:AddTab(tabName)
        local tabObj = {}
        tabObj.RayfieldTab = self.RayfieldWindow:CreateTab(tabName)
        tabObj.runtime = {}

        function tabObj:AddLabel(text)
            local labelObj = {}
            labelObj.RayfieldLabel = self.RayfieldTab:CreateLabel(text)
            setmetatable(labelObj, {
                __newindex = function(t, k, v)
                    if k == "Text" then t.RayfieldLabel:Set(v) else rawset(t, k, v) end
                end,
                __index = function(t, k)
                    if k == "Text" then return "" end
                    return rawget(t, k)
                end
            })
            return labelObj
        end

        function tabObj:AddButton(name, callback)
            return self.RayfieldTab:CreateButton({ Name = name, Callback = callback })
        end

        function tabObj:AddSwitch(name, callback)
            local switchObj = {}
            switchObj.RayfieldToggle = self.RayfieldTab:CreateToggle({
                Name = name, CurrentValue = false,
                Flag = name:gsub("%s+", "") .. tostring(math.random(1000, 9999)),
                Callback = callback
            })
            function switchObj:Set(bool) self.RayfieldToggle:Set(bool) end
            return switchObj
        end

        function tabObj:AddTextBox(name, callback, opts)
            local boxObj = { Text = "" }
            boxObj.RayfieldInput = self.RayfieldTab:CreateInput({
                Name = name, PlaceholderText = "...",
                RemoveTextAfterFocusLost = opts and opts.clear or false,
                Callback = function(Text)
                    boxObj.Text = Text
                    if callback then callback(Text) end
                end
            })
            return boxObj
        end

        function tabObj:AddDropdown(name, callback)
            local dropdownObj = {}
            dropdownObj.OptionsList = {}
            dropdownObj.RayfieldDropdown = self.RayfieldTab:CreateDropdown({
                Name = name, Options = {}, CurrentOption = {""}, MultipleOptions = false,
                Flag = name:gsub("%s+", "") .. tostring(math.random(1000, 9999)),
                Callback = function(Option)
                    if type(Option) == "table" and Option[1] then callback(Option[1])
                    elseif type(Option) == "string" then callback(Option) end
                end
            })

            function dropdownObj:Add(item)
                table.insert(self.OptionsList, item)
                self.RayfieldDropdown:Refresh(self.OptionsList)
            end

            function dropdownObj:Remove(item)
                for i, v in ipairs(self.OptionsList) do
                    if v == item then table.remove(self.OptionsList, i) break end
                end
                self.RayfieldDropdown:Refresh(self.OptionsList)
            end

            function dropdownObj:Clear()
                self.OptionsList = {}
                self.RayfieldDropdown:Refresh(self.OptionsList)
            end
            return dropdownObj
        end
        function tabObj:Show() end
        return tabObj
    end
    return windowObj
end

